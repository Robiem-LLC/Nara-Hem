# Shared editor settings for every language in the repository.
# Formatters (Prettier, Ruff, ktlint, shfmt) read these values too.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.{py,kt,kts,swift}]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[*.{kt,kts}]
ktlint_code_style = android_studio
# Jetpack Compose functions are named like types (e.g. MapScreen).
ktlint_function_naming_ignore_when_annotated_with = Composable
# Not on by default in the Android Studio style; unused imports should not linger.
ktlint_standard_no-unused-imports = enabled

[*.sh]
# shfmt options
switch_case_indent = true
space_redirects = true
