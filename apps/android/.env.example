# Copy to .env in this directory. Do not commit the populated file.
# Household server URLs are entered during enrollment, never embedded into distributable APKs.
# Required for downloadable Google Maps Android APKs (only supported release flavor).
# Blank is permitted only for optional local OpenStreetMap/MapLibre development.
# This is the Android key, not the browser key in Docker's .env.
NARAHEM_GOOGLE_MAPS_ANDROID_API_KEY=
