<resources>
    <!-- Android 12 and later draw their own splash screen: the icon on the app's blue. -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/narahem_midnight</item>
        <item name="android:windowSplashScreenBackground">@color/narahem_midnight</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/narahem_midnight</item>
    </style>
</resources>
